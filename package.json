{
	"name": "clash-armies",
	"version": "0.13.0",
	"private": true,
	"type": "module",
	"imports": {
		"#types": "./src/lib/shared/types.ts",
		"#components/*": "./src/components/*",
		"#assets/*": "./src/lib/assets/*",
		"#models/*": "./src/lib/models/*",
		"#client/*": "./src/lib/client/*",
		"#server/*": "./src/lib/server/*",
		"#shared/*": "./src/lib/shared/*"
	},
	"scripts": {
		"start:before": "docker compose up -d",
		"start": "pnpm run start:before && vite dev",
		"start:network": "pnpm run start:before && vite dev --host",
		"start:https": "DEV_HTTPS=1 pnpm run start:network",
		"production": "vite preview",
		"build": "vite build",
		"build:dev-image": "docker build -t clash-armies:devel .",
		"build:db-types": "scripts/build-db-types.sh",
		"test:before": "docker compose --env-file=.env.test --file=compose.test.yaml up -d",
		"test:coverage": "pnpm run test:before && vitest run --coverage",
		"test:ui": "pnpm run test:before && vitest --ui --coverage.enabled=true",
		"test": "pnpm run test:before && vitest run",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json src",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "eslint --fix",
		"lint:check": "eslint"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-bold": "^3.32.0",
		"@tiptap/extension-document": "^3.32.0",
		"@tiptap/extension-heading": "^3.32.0",
		"@tiptap/extension-horizontal-rule": "^3.32.0",
		"@tiptap/extension-italic": "^3.32.0",
		"@tiptap/extension-link": "^3.32.0",
		"@tiptap/extension-list": "^3.32.0",
		"@tiptap/extension-paragraph": "^3.32.0",
		"@tiptap/extension-strike": "^3.32.0",
		"@tiptap/extension-text": "^3.32.0",
		"@tiptap/extension-text-align": "^3.32.0",
		"@tiptap/extensions": "^3.32.0",
		"@tiptap/html": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"cookie-signature": "1.2.2",
		"cron": "4.4.0",
		"date-fns": "4.4.0",
		"json5": "^2.2.3",
		"kysely": "^0.29.6",
		"mysql2": "^3.24.6",
		"zeed-dom": "0.18.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/cookie-signature": "1.1.2",
		"@types/eslint": "9.6.1",
		"@types/node": "26.6.5",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-basic-ssl": "2.3.0",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/ui": "^5.0.5",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"kysely-codegen": "^0.20.0",
		"oxfmt": "^0.73.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.9.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=26.12.0"
	},
	"packageManager": "pnpm@12.14.0"
}
