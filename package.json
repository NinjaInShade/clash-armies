{
	"name": "clash-armies",
	"version": "0.11.3",
	"private": true,
	"type": "module",
	"scripts": {
		"start:before": "docker compose up -d",
		"start": "pnpm run start:before && vite dev",
		"start:network": "pnpm run start:before && vite dev --host",
		"start:https": "DEV_HTTPS=1 pnpm run start:network",
		"production": "vite preview",
		"build": "vite build",
		"build:dev-image": "docker build -t clash-armies:devel .",
		"build:db-types": "scripts/build-db-types.sh",
		"test:before": "docker compose --env-file=.env.test --file=compose.test.yaml down -v && docker compose --env-file=.env.test --file=compose.test.yaml up -d",
		"test:coverage": "pnpm run test:before && vitest run --coverage",
		"test:ui": "pnpm run test:before && vitest --ui --coverage.enabled=true",
		"test": "pnpm run test:before && vitest run",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json src"
	},
	"engines": {
		"node": ">=26.3.0"
	},
	"packageManager": "pnpm@11.0.3",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/eslint": "9.6.1",
		"@types/cookie-signature": "1.1.2",
		"@types/node": "26.1.1",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"@vitejs/plugin-basic-ssl": "2.3.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-eslint-parser": "^1.8.0",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"kysely-codegen": "^0.20.0"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@tiptap/core": "^3.29.2",
		"@tiptap/extension-bold": "^3.29.2",
		"@tiptap/extension-character-count": "^3.29.2",
		"@tiptap/extension-document": "^3.29.2",
		"@tiptap/extension-heading": "^3.29.2",
		"@tiptap/extension-horizontal-rule": "^3.29.2",
		"@tiptap/extension-italic": "^3.29.2",
		"@tiptap/extension-link": "^3.29.2",
		"@tiptap/extension-list": "^3.29.2",
		"@tiptap/extension-list-keymap": "^3.29.2",
		"@tiptap/extension-paragraph": "^3.29.2",
		"@tiptap/extension-placeholder": "^3.29.2",
		"@tiptap/extension-strike": "^3.29.2",
		"@tiptap/extension-text": "^3.29.2",
		"@tiptap/extension-text-align": "^3.29.2",
		"@tiptap/extensions": "^3.29.2",
		"@tiptap/html": "^3.29.2",
		"@tiptap/pm": "^3.29.2",
		"@tiptap/starter-kit": "^3.29.2",
		"zeed-dom": "0.18.0",
		"arctic": "3.7.0",
		"cron": "4.4.0",
		"date-fns": "4.4.0",
		"json5": "^2.2.3",
		"uuid": "^14.0.1",
		"kysely": "^0.29.2",
		"mysql2": "^3.22.5",
		"cookie-signature": "1.2.2",
		"zod": "4.4.3"
	}
}
